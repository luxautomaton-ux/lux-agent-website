{
  "name": "lux-agent-website",
  "main": "./cloudflare/asset-compat.ts",
  "compatibility_date": "2026-10-02",
  "routes": [
    { "pattern": "myluxagent.com", "custom_domain": true },
    { "pattern": "www.myluxagent.com", "custom_domain": true },
    { "pattern": "viewer.myluxagent.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/desktop",
      "/desktop/*",
      "/usb",
      "/usb/*",
      "/viewer",
      "/viewer/*",
      "/builder",
      "/builder/*",
      "/lux-agent-website",
      "/lux-agent-website/*"
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
