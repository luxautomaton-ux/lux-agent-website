# Public Lux support API. Must expose only customer-safe routes.
# Example: https://support-api.luxagent.example
NEXT_PUBLIC_LUX_SUPPORT_API_URL=

# Canonical public URL. Cloudflare production uses https://myluxagent.com.
# GitHub Pages falls back to its repository URL when this is unset.
NEXT_PUBLIC_SITE_URL=

# Leave unset for normal GitHub Pages builds. Set to an empty value for
# Cloudflare/custom-domain builds so routes live at the domain root.
NEXT_PUBLIC_SITE_BASE_PATH=

# Public Supabase Edge Function URL used by Build My Lux checkout.
# The function remains non-charging until Stripe secrets, allowed origins,
# and active catalog price IDs are configured in Supabase.
NEXT_PUBLIC_LUX_AGENT_CHECKOUT_URL=https://khyzmyvrfjwwnbvwfhhk.supabase.co/functions/v1/lux-agent-checkout
